# ---- Runtime ----
NODE_ENV=development
PORT=8080
# DATABASE_URL is injected by docker-compose; set it yourself when not using compose.
DATABASE_URL=postgres://ziarat:change-me@localhost:5432/ziarat
DATABASE_SSL=disable            # disable | require | verify  (use verify + DATABASE_CA_CERT in production)
# DATABASE_CA_CERT=
CORS_ORIGINS=                   # leave empty: a mobile app does not need CORS

# ---- Auth ----
# Development ONLY. The server refuses to start with this true when NODE_ENV=production.
ALLOW_DEV_AUTH=false

# ---- Privy (dashboard.privy.io) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WEBHOOK_SIGNING_KEY=      # Dashboard > Webhooks > signing key (whsec_...)
PRIVY_AUTHORIZATION_PRIVATE_KEY=   # authorization key used to sign wallet actions (keep in a secrets manager)
PRIVY_SPONSOR_GAS=false         # true = Privy pays gas (needs gas sponsorship enabled in the dashboard)

# ---- Chain and assets (start on a testnet!) ----
ZIARAT_CHAIN_ID=11155111        # 11155111 = Sepolia testnet. Mainnet = 1. Set deliberately.
ZIARAT_ENABLED_ASSETS=ETH,USDT,USDC,ZIAR
ZIARAT_USDT_CONTRACT=
ZIARAT_USDC_CONTRACT=
ZIARAT_ZIAR_CONTRACT=
# Decimals default to USDT=6, USDC=6, ZIAR=18. Override ONLY if the token on your chain differs.
# ZIARAT_USDT_DECIMALS=6

# ---- Withdrawals (OFF until you turn them on) ----
ZIARAT_WITHDRAWALS_ENABLED=false
ZIARAT_REQUIRE_KYC=true         # users must have kyc_status='approved' to withdraw
# asset:perTx:perDay in human units. Required for every enabled asset when withdrawals are on.
ZIARAT_WITHDRAW_LIMITS=ETH:0.05:0.2;USDT:100:300;USDC:100:300;ZIAR:1000:3000
ZIARAT_NATIVE_GAS_RESERVE=0.002 # ETH kept back for fees when withdrawing ETH (ignored if PRIVY_SPONSOR_GAS=true)

# ---- Settlement, reconciliation and operations (v3) ----
# Production REFUSES to start without: PRIVY_AUTHORIZATION_PRIVATE_KEY, ZIARAT_RPC_URL, ZIARAT_REQUIRE_KYC=true, DATABASE_SSL!=disable.
ZIARAT_RPC_URL=                 # JSON-RPC endpoint for ZIARAT_CHAIN_ID (Alchemy/Infura/own node). Deposits and withdrawals are verified here.
ZIARAT_MIN_CONFIRMATIONS=12     # confirmations before crediting a deposit / settling or refunding a withdrawal
ZIARAT_PENDING_TIMEOUT_SECONDS=300     # crash mid-send -> manual review after this long
ZIARAT_DROPPED_TX_SECONDS=3600         # submitted tx unknown to the chain after this long -> manual review
ZIARAT_RECONCILE_INTERVAL_SECONDS=60
TRUST_PROXY=false               # true behind a load balancer/reverse proxy (so rate limits use the real client IP)
# ADMIN_API_KEY=                # 32+ random chars. Unset = /admin routes disabled. Expose only on a private network/VPN.
